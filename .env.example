# Local Postgres (docker compose up -d)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecom
POSTGRES_PORT=5432

DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom
# Optional pool tuning
# DATABASE_POOL_MAX=10

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=change-me

# Passwords for the accounts `npm run db:seed` creates (or resets on every run): the admin
# (iluu0456@gmail.com) and the test customers, who own the sample orders.
SEED_ADMIN_PASSWORD=change-me
SEED_CUSTOMER_ANNA_PASSWORD=change-me    # anna@northcart.test  (Anna Kowalska, Warszawa)
SEED_CUSTOMER_BEN_PASSWORD=change-me     # ben@northcart.test   (Ben Carter, San Francisco)
SEED_CUSTOMER_CHLOE_PASSWORD=change-me   # chloe@northcart.test (Chloe Martin, London)

# Media storage: any S3-compatible service. Locally that's S3Mock from docker compose, which
# ignores credentials. In production point these at AWS S3 or Cloudflare R2 (leave S3_ENDPOINT
# empty for AWS; for R2 it's https://<account-id>.r2.cloudflarestorage.com).
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=northcart-media
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
# S3_PORT=9090                  # host port for the local S3 emulator
# Public base URL objects are served from: the CDN in front of the bucket in production
# (e.g. an R2 custom domain behind Cloudflare). Read at build time too, by next.config.ts.
MEDIA_PUBLIC_URL=http://localhost:9090/northcart-media

# Logging (src/lib/logger.ts): debug | info | warn | error. Defaults: debug in dev, info in prod.
# LOG_LEVEL=debug
# NEXT_PUBLIC_LOG_LEVEL=debug   # same, for the browser
# LOG_FORMAT=pretty             # pretty | json (defaults to json in prod)

# Email (src/lib/mail.ts). Locally that's Mailpit from docker compose: it catches everything,
# browse it at http://localhost:8025. Leave SMTP_HOST empty to skip sending (emails are only
# logged), as CI does. SMTP_USER / SMTP_PASS are only needed by real providers.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false             # true for implicit TLS (usually port 465)
MAIL_FROM="Northcart <no-reply@northcart.test>"
# MAILPIT_SMTP_PORT=1025        # host ports for the local Mailpit container
# MAILPIT_UI_PORT=8025
# Absolute base URL of the site, for links in emails (no trailing slash).
APP_URL=http://localhost:3000
