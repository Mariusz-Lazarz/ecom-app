# Local Postgres (docker compose up -d)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecom
POSTGRES_PORT=5432

DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom
# Optional pool tuning
# DATABASE_POOL_MAX=10

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=change-me

# Password for the admin account `npm run db:seed` creates (or resets on every run).
SEED_ADMIN_PASSWORD=change-me

# Media storage: any S3-compatible service. Locally that's S3Mock from docker compose, which
# ignores credentials. In production point these at AWS S3 or Cloudflare R2 (leave S3_ENDPOINT
# empty for AWS; for R2 it's https://<account-id>.r2.cloudflarestorage.com).
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=northcart-media
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
# S3_PORT=9090                  # host port for the local S3 emulator
# Public base URL objects are served from: the CDN in front of the bucket in production
# (e.g. an R2 custom domain behind Cloudflare). Read at build time too, by next.config.ts.
MEDIA_PUBLIC_URL=http://localhost:9090/northcart-media

# Logging (src/lib/logger.ts): debug | info | warn | error. Defaults: debug in dev, info in prod.
# LOG_LEVEL=debug
# NEXT_PUBLIC_LOG_LEVEL=debug   # same, for the browser
# LOG_FORMAT=pretty             # pretty | json (defaults to json in prod)
