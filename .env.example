# Local Postgres (docker compose up -d)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecom
POSTGRES_PORT=5432

DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom
# Optional pool tuning
# DATABASE_POOL_MAX=10

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=change-me
